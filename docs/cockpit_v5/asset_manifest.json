      "radar": 12,
      "diagnostics": 10,
      "text": 6
    },
    "no_new_gameplay_state": true,
    "classic_mode": "untouched",
    "v4_modern_mode": "retained as fallback pending visual approval"
  },
  "rules": [
    "Art assets must NEVER include legible numbers, labels, radar contacts, moving pointers, score, warnings or gameplay scene.",
    "Every transparency cutout must align with its declared screen rect; a single flattened render is prohibited as a runtime asset.",
    "No UI elements are encoded in the game environment; the battlefield viewport remains unobstructed.",
    "Art exports must match exact declared pixel dimensions and contain RGBA transparency.",
    "No dynamic values without source telemetry; unimplemented system meters must be omitted, not invented."
  ]
